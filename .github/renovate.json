{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinDigests", ":dependencyDashboard"],
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "Pin GitHub Actions to commit SHAs (supply-chain hygiene).",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Group non-major npm updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm (non-major)"
    }
  ],
  "docker": { "pinDigests": true }
}
