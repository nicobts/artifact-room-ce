# ---------------------------------------------------------------------------
# Artifact Room — environment configuration
# Copy to `.env` and fill in. NEVER commit a real `.env` (see .gitignore).
# ---------------------------------------------------------------------------

# --- Origins (the two-identity spine) -------------------------------------
# One container serves both; middleware branches on the Host header.
# Dev/CI use *.localhost (browsers map these to 127.0.0.1 automatically).
APP_ORIGIN=http://app.localhost:3000
VIEWER_ORIGIN=http://view.localhost:3000
# Number of TRUSTED reverse-proxy hops in front of the container. IP-based rate
# limiting reads the client IP as the Nth-from-rightmost X-Forwarded-For entry;
# the leftmost entries are client-supplied and MUST NOT be trusted. Default 1 (a
# single reverse proxy — the shipped Caddy/nginx). Set higher only when you add
# more trusted proxies (e.g. Cloudflare -> nginx -> app = 2). A proxy-less
# deployment is not a supported production topology.
TRUSTED_PROXY_HOPS=1

# --- Creator auth (BetterAuth — creators ONLY, never viewers) -------------
# Generate a strong secret, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-secret
BETTER_AUTH_URL=http://app.localhost:3000
# Who may register: `invite` (allowlist-gated — the secure default) or `open`
# (anyone). Only choose `open` for a trusted/private instance.
SIGNUP_MODE=invite
# In `invite` mode, only these emails may register (comma-separated).
SIGNUP_ALLOWLIST=
# PROMOTE-ONLY admin bootstrap: at boot, any EXISTING user whose email is
# listed here (comma-separated, case-insensitive) is promoted to the `admin`
# role. Removing an email never demotes — manage roles in /admin. Lockout
# recovery: add your email here and restart. A user who registers after boot
# is promoted at the NEXT boot. Day-to-day role management lives in /admin.
ADMIN_EMAILS=

# --- Dev test credentials (DEVELOPMENT ONLY — hard no-op in production) ----
# When both are set, this account is created at boot if it doesn't exist
# (min password length 8). Add the email to ADMIN_EMAILS above to make it an
# admin in the same boot; in `invite` mode it must also be on
# SIGNUP_ALLOWLIST. Never a provisioning mechanism for real instances.
# DEV_SEED_EMAIL=
# DEV_SEED_PASSWORD=
# DEV_SEED_NAME=

# --- Persistence (single volume: SQLite file + blob dir) ------------------
# Both live under DATA_DIR so one backup captures all state.
DATA_DIR=./data
DATABASE_PATH=./data/artifact-room.sqlite

# --- Viewer render security (viewer-render-sandbox) -----------------------
# Secure-by-default: empty = external subresources blocked (artifacts are
# expected to be self-contained single-file HTML). A self-hoster MAY opt into a
# curated, read-only CDN allowlist (space-separated origins). connect-src 'none'
# and form-action 'none' hold regardless of this list.
VIEWER_CDN_ALLOWLIST=
# Secret for the password-gate access cookie (falls back to BETTER_AUTH_SECRET).
VIEWER_ACCESS_SECRET=

# --- Observability (ops-hardening) ----------------------------------------
LOG_LEVEL=info
# OpenTelemetry is opt-in; leave unset to disable (no external calls).
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Backups (ops-hardening — Litestream; DR infra, not app storage) ------
# LITESTREAM_REPLICA_URL=s3://your-bucket/artifact-room
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# --- Abuse scanning (artifact-upload) -------------------------------------
# Google Safe Browsing API key for outbound-URL lookups (optional in dev).
# SAFE_BROWSING_API_KEY=

# --- Open notifications email (open-notifications — OPTIONAL, off by default) --
# The in-app notifications bell works with NO email. Email is a secondary,
# best-effort signal: it sends ONLY when SMTP_HOST is set AND a creator opts in
# (per-creator `emailOnOpen`). Delivery uses `nodemailer`, an OPTIONAL peer dep
# — install it (`npm i nodemailer`) if you want real sends; otherwise email is a
# logged no-op. Never touches the viewer/beacon path.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=artifact-room@your-domain.example
